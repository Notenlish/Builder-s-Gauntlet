{
	"schemaVersion": 1,
	"id": "builders-gauntlet",
	"version": "${version}",
	"name": "Builder's Gauntlet",
	"description": "Combines pickaxe, axe and shovel into 1 tool! Perfect for builders.",
	"authors": [
		"Notenlish"
	],
	"contact": {
		"sources": "https://github.com/notenlish/builder-s-gauntlet"
	},
	"license": "MIT",
	"icon": "assets/builders-gauntlet/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"notenlish.buildersgauntlet.BuilderSGauntlet"
		],
		"client": [
			"notenlish.buildersgauntlet.client.BuilderSGauntletClient"
		],
		"fabric-datagen": [
			"notenlish.buildersgauntlet.client.datagen.ModDataGenerator"
		]
	},
	"mixins": [
		"builders-gauntlet.mixins.json",
		{
			"config": "builders-gauntlet.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}